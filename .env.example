# ---------------------------------------------------------------------------
# Yoga with Rekha — environment variables
# Copy to `.env.local` (git-ignored) and fill in. NEVER commit real values.
#
# Everything prefixed VITE_ is PUBLIC: it is compiled into the browser bundle.
# Only public identifiers belong here. Secrets go in Supabase function secrets (below).
# ---------------------------------------------------------------------------

# "demo" (default) = simulated, browser-only demo.
# "production"     = real Supabase auth + database. Demo sign-in, sample data, reset
#                    and simulated payments are compiled out of the bundle.
VITE_APP_MODE=demo

# --- Production only -------------------------------------------------------
# Supabase project URL and the ANON / publishable key (Project Settings → API).
# The site refuses to start if these are missing, or if a service-role key is used here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL of the site (used in auth email links), e.g. https://yogawithrekha.com
VITE_SITE_URL=

# Payments: leave EMPTY to keep enrollment closed ("Online enrollment isn't open yet").
# Set to "razorpay" only after merchant eligibility for India + international cards is confirmed.
VITE_PAYMENT_PROVIDER=
# Razorpay KEY ID only (rzp_test_… / rzp_live_…). Never the key secret.
VITE_PAYMENT_PUBLIC_KEY=

# "enabled" once the private `lesson-videos` bucket and the `lesson-playback` function are deployed.
VITE_VIDEO_HOSTING=

# Sub-folder deploys (GitHub Pages preview uses /yogawithrekha/)
# VITE_BASE=/yogawithrekha/

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — set with `supabase secrets set NAME=value`, never here:
#   SITE_URL                   https://yogawithrekha.com   (CORS + email links)
#   RAZORPAY_KEY_ID            rzp_live_…
#   RAZORPAY_KEY_SECRET        (secret)
#   RAZORPAY_WEBHOOK_SECRET    (secret, from the Razorpay webhook settings)
#   RESEND_API_KEY             (optional, purchase emails)
#   EMAIL_FROM                 "Yoga with Rekha <hello@yourdomain>"
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
# ---------------------------------------------------------------------------
